SPECIES=$(basename "$DIR")
FASTA="${SPECIES}/${SPECIES}_chrZ.fasta"
COORD_FILE="${SPECIES}/${SPECIES}_neoZ_coordinates.txt"

if [ -f "$FASTA" ] && [ -f "$COORD_FILE" ]; then
echo "Extracting region for ${SPECIES}..."


