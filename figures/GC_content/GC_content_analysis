# Script to calculate GC content along neo-Z chromosomes. My hypothesis is that Sylvioidea is udergoing GC biased gene conversion and therefore should have higher GC content. To test that I will calculate GC along neo-z and ancestral Z

## First I need to isolate the region neo region of the Z from the whole Z scaffold, either through Exonerate (only captures exons) or RagTag (more accurate because maps to everything). I tried both approaches and didnt show much difference so I will just use the Exonerate coordnates.

# 1. Data processing

```{bash, eval=FALSE}

#get the neo Z chromosome coordinates

for DIR in */; do
SPECIES=$(basename "$DIR")
GFF_FILE="${SPECIES}/${SPECIES}_Z_cds_mappings.gff"

if [ -f "$GFF_FILE" ]; then
echo "Processing ${SPECIES}..."

# 1. Extract Target Scaffold ID (from the first Target: line)
SCAFFOLD=$(grep -m 1 "Target:" "$GFF_FILE" | awk '{print $2}')

# 2. Extract Min (Start) and Max (End) coordinates
START=$(grep "Target range:" "$GFF_FILE" | grep -oE '[0-9]+' | sort -n | head -n 1)
END=$(grep "Target range:" "$GFF_FILE" | grep -oE '[0-9]+' | sort -n | tail -n 1)

# 3. Save formatted string to file inside the species folder
echo "${SCAFFOLD}:${START}-${END}" > "${SPECIES}/${SPECIES}_neoZ_coordinates.txt"
else
  echo "Skipping ${SPECIES}: GFF file not found."
fi
done



#now cut my Z chromosome fasta on these coordinates to isolate only neo-Z fasta
conda activate /dss/dsslegfs01/pr53da/pr53da-dss-0036/projects/2025__neosex/conda_envs/bio_env

