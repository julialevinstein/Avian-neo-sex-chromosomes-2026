# 2. Data analysis

## 2.1. Plotting Z chromosome GC content

### Meliphagidae

```{r}

library(dplyr)
library(ggplot2)
# Load data
df_mel <- read.table("C:/Users/Julia/Desktop/IRT3/GC_content/Meliphagidae/Myz_car_wholeZ_noN_GC_sliding_window.tsv", header=TRUE)

# Define your Neo-Z region boundaries (in Base Pairs)
neoZ_start <- 80398821
neoZ_end   <- 117761136

# Categorize windows based on their midpoint coordinate
df_mel <- df_mel %>%
  mutate(region_type = case_when(
    midpoint_bp >= neoZ_start & midpoint_bp <= neoZ_end ~ "Neo-Z",
    TRUE ~ "Ancestral Z"
  ))
ggplot(df_mel, aes(x = midpoint_bp / 1e6, y = gc_percent)) +
  geom_line(aes(color = region_type, group = 1), size = 0.8) +
  scale_color_manual(values = c("Ancestral Z" = "darkblue", "Neo-Z" = "firebrick")) +
  labs(x = "Position on Chromosome Z (Mb)", 
       y = "GC Content (%)", 
       title = "GC Content Along Chromosome Z",
       color = "Region") +
  theme_minimal() +
  theme(legend.position = "top")

```

