## Neo-z 2 species comparison

```{r}
library(dplyr)
library(ggplot2)
library(ggpubr) 

# 1. Filter each species dataset for 'Neo-Z' and tag the species name
neoz_syl <- df_syl %>%
  filter(region_type == "Neo-Z") %>%
  mutate(species = "Acr_pal")

neoz_mel <- df_mel %>%
  filter(region_type == "Neo-Z") %>%
  mutate(species = "Myz_car")

neoz_col <- df_col %>%
  filter(region_type == "Neo-Z") %>%
  mutate(species = "Cal_nic")

neoz_psi <- df_psi %>%
  filter(region_type == "Neo-Z") %>%
  mutate(species = "Mel_und")

neoz_ibi <- df_ibi %>%
  filter(region_type == "Neo-Z") %>%
  mutate(species = "Nip_nip")

# 2. Combine into one dataset
neoz_combined <- bind_rows(neoz_syl, neoz_mel)
neoz_combined <- bind_rows(neoz_syl, neoz_col)



#get non-overlapping regions
neoz_clean <- neoz_combined %>%
  filter(window_start %% 50000 == 0)



# 3. Run the Wilcoxon Rank Sum Test in the console
wilcox_res <- wilcox.test(gc_percent ~ species, data = neoz_clean)
print(wilcox_res)

# 4. Plot Violin + Boxplot with automatic p-value annotation
ggplot(neoz_clean, aes(x = species, y = gc_percent, fill = species)) +
  # Violin plot showing distribution shape
  geom_violin(alpha = 0.4, color = NA) +
  # Overlaid boxplot showing median and quartiles
  geom_boxplot(width = 0.2, color = "black", outlier.shape = NA, alpha = 0.8) +
  # Color palette
  scale_fill_manual(values = c("Acr_pal" = "#4575b4", "Cal_nic" = "#74add1")) +
  # Statistical test annotation directly on the plot
  stat_compare_means(
    method = "wilcox.test",
    label = "p.format",
    label.x = 1.5,
    size = 4.5
  ) +
  labs(
    title = "Comparison of Neo-Z GC Content",
    x = "Species",
    y = "GC Content (%)"
  ) +
  theme_classic() +
  theme(
    legend.position = "none",
    axis.text = element_text(size = 11, color = "black"),
    axis.title = element_text(size = 12, face = "bold"),
    plot.title = element_text(size = 13, face = "bold", hjust = 0.5)
  )
```

